---
interface Props {
  href?: string;
  LinkUrl?: string;
  LinkText?: string;
}

const { href, LinkUrl, LinkText } = Astro.props;
const resolvedHref = href ?? LinkUrl ?? '#';
---

<a class="link" href={resolvedHref} target="_blank" rel="noopener noreferrer">
  <span class="text">{LinkText}<slot /></span>{'\u00a0'}<span class="icon icon-open-new" aria-hidden="true"></span>
  <span class="screen-reader-only">(opens in a new tab)</span>
</a>

<style>
  a.link {
    display: inline;
  }
</style>
